# Public site URL — used in metadata/canonical links.
NEXT_PUBLIC_SITE_URL=https://carlamontano.io

# GA4 Measurement ID (Admin → Data Streams → your web stream). Public/client-side by design —
# loads the gtag.js tracking snippet on every public page. Leave unset to skip loading it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase — server-only, never exposed to the client
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase anon/publishable key — used for the admin login session (respects RLS,
# safe to expose to the browser). Different from the service_role key above.
SUPABASE_ANON_KEY=

# Resend — transactional email (quiz result, sequences, newsletter, booking confirmations)
RESEND_API_KEY=
FROM_EMAIL=
# Signing secret for Resend's webhook (Dashboard → Webhooks → your endpoint),
# used to record delivered/opened/clicked/bounced on each sent email.
RESEND_WEBHOOK_SECRET=

# The only email allowed to log into /admin. Create this exact user manually in
# Supabase Dashboard → Authentication → Users → Add User (no public signup exists).
ADMIN_EMAIL=

# Stripe — Mentoría 1:1 checkout + webhook (Fase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
